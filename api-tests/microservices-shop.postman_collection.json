{
  "info": {
    "_postman_id": "8d986af8-1a11-5e41-90a0-9df60182cea0",
    "name": "Microservices Shop: API test plan",
    "description": "Learn and check the flows of the microservices shop: Keycloak login, API gateway security, product catalog, inventory, order placement (order → inventory), known gaps, and resilience (circuit breakers, fallbacks).\n\nStart the stack with `./launch.sh`, then run folders 0–5 in order (automated). Folder 6 is manual. Full guide: `docs/TEST_PLAN.md`.\n\nFormat: Postman Collection v2.1. Also imports into Insomnia and Bruno.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Setup & smoke",
      "description": "Run this folder first. It logs in to Keycloak and stores the access token in the `accessToken` variable, which every other request sends as `Authorization: Bearer ...` (configured once at collection level).\n\nTokens live 5 minutes (realm setting). If requests start returning 401, run **Get access token** again.",
      "item": [
        {
          "name": "Get access token (Keycloak password grant)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Logs in as the realm's test user with the OAuth2 *password* grant (enabled on the `angular-client` client for testing). The browser app uses Authorization Code + PKCE instead, but both produce the same kind of JWT.\n\nThe test script saves the token into the `accessToken` collection variable.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "openid profile",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Returns a bearer access token', function () {",
                  "  pm.expect(body.access_token).to.be.a('string');",
                  "  pm.expect(body.token_type).to.eql('Bearer');",
                  "  pm.expect(body.expires_in).to.be.above(0);",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway health (actuator, needs token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/actuator/health",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Spring Boot Actuator on the gateway. It is **not** in the gateway's public URL list, so it needs a valid token (without one you get 401). Shows the gateway's circuit breaker health indicators."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('Gateway is UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Aggregated API docs (public, no token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/aggregate/product-service/v3/api-docs",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "aggregate",
                "product-service",
                "v3",
                "api-docs"
              ]
            },
            "description": "The gateway proxies each service's OpenAPI document under `/aggregate/**`, which is public (no token). This is what feeds the Swagger UI at `{{gatewayUrl}}/swagger-ui.html`.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('Returns an OpenAPI document', function () {",
                  "  pm.expect(pm.response.json().openapi).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Security (gateway edge)",
      "description": "The API gateway is an OAuth2 resource server: it validates the JWT signature against Keycloak before routing. These requests show what happens when the token is missing, invalid, or cannot be obtained.",
      "item": [
        {
          "name": "No token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/product",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "product"
              ]
            },
            "description": "No `Authorization` header. The gateway rejects the call before it reaches product-service and answers with an empty body and a `WWW-Authenticate: Bearer` header.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.expect(pm.response.code).to.eql(401); });",
                  "pm.test('Asks for a bearer token', function () {",
                  "  pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/product",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "product"
              ]
            },
            "description": "A syntactically JWT-shaped but fake token. Signature validation fails, so the gateway returns 401.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "abc.def.ghi",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.expect(pm.response.code).to.eql(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Wrong password at Keycloak → 401",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token",
              "host": [
                "{{keycloakUrl}}"
              ],
              "path": [
                "realms",
                "{{realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            },
            "description": "Keycloak refuses the login, so no token is issued at all.",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "definitely-wrong",
                  "type": "text"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.expect(pm.response.code).to.eql(401); });",
                  "pm.test('Error is invalid_grant', function () {",
                  "  pm.expect(pm.response.json().error).to.eql('invalid_grant');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Product catalog (product-service, MongoDB)",
      "description": "Flow: client → gateway → product-service → MongoDB.\n\nNote: there is no delete endpoint, so every run adds a product to the catalog.",
      "item": [
        {
          "name": "Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/product",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "product"
              ]
            },
            "description": "Creates a product whose SKU matches seeded inventory (`{{inStockSku}}`), so it can be ordered. MongoDB assigns the `id`; the test stores it in `createdProductId`.\n\nCreating a product does **not** create stock. Only the four seeded SKUs (iphone_15, pixel_8, galaxy_24, oneplus_12) are orderable.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"iPhone 15\",\n  \"description\": \"Apple smartphone, created by the API test plan\",\n  \"skuCode\": \"{{inStockSku}}\",\n  \"price\": 999.99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "const p = pm.response.json();",
                  "pm.test('Product has an id and the sent fields', function () {",
                  "  pm.expect(p.id).to.be.a('string');",
                  "  pm.expect(p.skuCode).to.eql(pm.collectionVariables.get('inStockSku'));",
                  "  pm.expect(p.price).to.eql(999.99);",
                  "});",
                  "pm.collectionVariables.set('createdProductId', p.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/product",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "product"
              ]
            },
            "description": "Returns every product. The test checks that the product created in the previous request is in the list."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const list = pm.response.json();",
                  "pm.test('Response is an array', function () { pm.expect(list).to.be.an('array'); });",
                  "pm.test('Contains the product created earlier', function () {",
                  "  const id = pm.collectionVariables.get('createdProductId');",
                  "  pm.expect(list.map(function (p) { return p.id; })).to.include(id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed JSON → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/product",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "product"
              ]
            },
            "description": "Broken JSON body. Spring cannot parse it and answers 400 Bad Request.",
            "body": {
              "mode": "raw",
              "raw": "{\"name\": ",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.expect(pm.response.code).to.eql(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Inventory (inventory-service, MySQL)",
      "description": "Flow: client → gateway → inventory-service → MySQL.\n\nThe answer is a plain `true`/`false`: is there a row with this SKU and at least this quantity? Each seeded SKU has 100 units, and the number never changes (orders do not decrement it; see folder 5).",
      "item": [
        {
          "name": "In stock (quantity 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory?skuCode={{inStockSku}}&quantity=1",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory"
              ],
              "query": [
                {
                  "key": "skuCode",
                  "value": "{{inStockSku}}"
                },
                {
                  "key": "quantity",
                  "value": "1"
                }
              ]
            },
            "description": "1 unit of a seeded SKU is available."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('In stock = true', function () {",
                  "  pm.expect(pm.response.text().trim()).to.eql('true');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Boundary: exactly the stock (100)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory?skuCode={{inStockSku}}&quantity=100",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory"
              ],
              "query": [
                {
                  "key": "skuCode",
                  "value": "{{inStockSku}}"
                },
                {
                  "key": "quantity",
                  "value": "100"
                }
              ]
            },
            "description": "The query is `quantity >= requested`, so asking for exactly 100 still returns true."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('In stock = true', function () {",
                  "  pm.expect(pm.response.text().trim()).to.eql('true');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Boundary: one more than stock (101)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory?skuCode={{inStockSku}}&quantity=101",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory"
              ],
              "query": [
                {
                  "key": "skuCode",
                  "value": "{{inStockSku}}"
                },
                {
                  "key": "quantity",
                  "value": "101"
                }
              ]
            },
            "description": "101 exceeds the 100 seeded units."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('In stock = false', function () {",
                  "  pm.expect(pm.response.text().trim()).to.eql('false');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown SKU",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory?skuCode=nokia_3310&quantity=1",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory"
              ],
              "query": [
                {
                  "key": "skuCode",
                  "value": "nokia_3310"
                },
                {
                  "key": "quantity",
                  "value": "1"
                }
              ]
            },
            "description": "No inventory row exists for this SKU."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('In stock = false', function () {",
                  "  pm.expect(pm.response.text().trim()).to.eql('false');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing quantity parameter → 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gatewayUrl}}/api/inventory?skuCode={{inStockSku}}",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "inventory"
              ],
              "query": [
                {
                  "key": "skuCode",
                  "value": "{{inStockSku}}"
                }
              ]
            },
            "description": "`quantity` is a required request parameter, so Spring rejects the call with 400."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', function () { pm.expect(pm.response.code).to.eql(400); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Order flow (order-service → inventory-service)",
      "description": "Flow: client → gateway → order-service → **inventory-service** (REST call through Resilience4j circuit breaker + retry) → order saved in MySQL.\n\nThis is the only service-to-service call in the system.",
      "item": [
        {
          "name": "Place order (in stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/order",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "order"
              ]
            },
            "description": "order-service asks inventory-service whether 1 unit is in stock, gets `true`, and saves the order with a random UUID order number. The response is plain text.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"{{inStockSku}}\",\n  \"price\": 999.99,\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "pm.test('Order accepted', function () {",
                  "  pm.expect(pm.response.text()).to.eql('Order Placed Successfully');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Place order (out of stock) → 500",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/order",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "order"
              ]
            },
            "description": "inventory-service answers `false`, and order-service throws a RuntimeException. Current behaviour is a generic **500**, not a 4xx like 409 or 422. Nothing is saved.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"{{inStockSku}}\",\n  \"price\": 999.99,\n  \"quantity\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 500', function () { pm.expect(pm.response.code).to.eql(500); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Place order (unknown SKU) → 500",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/order",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "order"
              ]
            },
            "description": "Same as out of stock: no inventory row, so `false`, so 500.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"nokia_3310\",\n  \"price\": 10,\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 500', function () { pm.expect(pm.response.code).to.eql(500); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Place order as the web app sends it (with userDetails)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gatewayUrl}}/api/order",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "order"
              ]
            },
            "description": "The Angular app also sends `userDetails` (email, first/last name). order-service ignores unknown fields, so the order succeeds, but the customer details are **not stored** anywhere.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skuCode\": \"galaxy_24\",\n  \"price\": 899,\n  \"quantity\": 1,\n  \"userDetails\": {\n    \"email\": \"testuser@example.com\",\n    \"firstName\": \"Test\",\n    \"lastName\": \"User\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.expect(pm.response.code).to.eql(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Circuit breaker state (order-service actuator)",
          "request": {
            "method": "GET",
            "header": [],
