            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "const cb = pm.response.json().circuitBreakers.inventory;",
                  "pm.test('Inventory circuit breaker is OPEN', function () { pm.expect(cb.state).to.eql('OPEN'); });"
                ]
              }
            }
          ]
        },
