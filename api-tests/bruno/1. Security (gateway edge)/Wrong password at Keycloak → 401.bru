meta {
  name: Wrong password at Keycloak → 401
  type: http
  seq: 3
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{username}}
  password: definitely-wrong
}

script:post-response {
  test('Status is 401', function () { expect(res.getStatus()).to.eql(401); });
  test('Error is invalid_grant', function () {
    expect(res.getBody().error).to.eql('invalid_grant');
  });
}

settings {
  encodeUrl: true
}

docs {
  Keycloak refuses the login, so no token is issued at all.
}
