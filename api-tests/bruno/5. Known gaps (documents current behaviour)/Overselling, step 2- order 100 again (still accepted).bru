meta {
  name: Overselling, step 2: order 100 again (still accepted)
  type: http
  seq: 3
}

post {
  url: {{gatewayUrl}}/api/order
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "skuCode": "pixel_8",
    "price": 699,
    "quantity": 100
  }
}

script:post-response {
  test('Status is 201', function () { expect(res.getStatus()).to.eql(201); });
}

settings {
  encodeUrl: true
}

docs {
  Orders 100 more. Because placing an order never decrements inventory, this is accepted too, so 200 units have been sold out of 100.
}
