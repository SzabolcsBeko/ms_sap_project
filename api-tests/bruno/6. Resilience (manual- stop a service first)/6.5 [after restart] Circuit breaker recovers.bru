meta {
  name: 6.5 [after restart] Circuit breaker recovers
  type: http
  seq: 5
}

get {
  url: {{orderServiceUrl}}/actuator/circuitbreakers
  body: none
  auth: none
}

script:post-response {
  test('Status is 200', function () { expect(res.getStatus()).to.eql(200); });
  const cb = res.getBody().circuitBreakers.inventory;
  test('Inventory circuit breaker is CLOSED again', function () { expect(cb.state).to.eql('CLOSED'); });
}

settings {
  encodeUrl: true
}

docs {
  After `./launch.sh` restarts inventory-service and 5 s have passed, the breaker goes HALF_OPEN; 3 successful orders close it again. Run folder 4 → *Place order (in stock)* 3 times, then this request.
}
