meta {
  name: Place order (in stock)
  type: http
  seq: 1
}

post {
  url: {{gatewayUrl}}/api/order
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "skuCode": "{{inStockSku}}",
    "price": 999.99,
    "quantity": 1
  }
}

script:post-response {
  test('Status is 201', function () { expect(res.getStatus()).to.eql(201); });
  test('Order accepted', function () {
    expect(JSON.stringify(res.getBody())).to.include('Order Placed Successfully');
  });
}

settings {
  encodeUrl: true
}

docs {
  order-service asks inventory-service whether 1 unit is in stock, gets `true`, and saves the order with a random UUID order number. The response is plain text.
}
