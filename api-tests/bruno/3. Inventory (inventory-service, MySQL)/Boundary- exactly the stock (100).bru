meta {
  name: Boundary: exactly the stock (100)
  type: http
  seq: 2
}

get {
  url: {{gatewayUrl}}/api/inventory?skuCode={{inStockSku}}&quantity=100
  body: none
  auth: inherit
}

params:query {
  skuCode: {{inStockSku}}
  quantity: 100
}

script:post-response {
  test('Status is 200', function () { expect(res.getStatus()).to.eql(200); });
  test('In stock = true', function () {
    expect(JSON.stringify(res.getBody()).trim()).to.eql('true');
  });
}

settings {
  encodeUrl: true
}

docs {
  The query is `quantity >= requested`, so asking for exactly 100 still returns true.
}
