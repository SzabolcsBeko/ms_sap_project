meta {
  name: Unknown SKU
  type: http
  seq: 4
}

get {
  url: {{gatewayUrl}}/api/inventory?skuCode=nokia_3310&quantity=1
  body: none
  auth: inherit
}

params:query {
  skuCode: nokia_3310
  quantity: 1
}

script:post-response {
  test('Status is 200', function () { expect(res.getStatus()).to.eql(200); });
  test('In stock = false', function () {
    expect(JSON.stringify(res.getBody()).trim()).to.eql('false');
  });
}

settings {
  encodeUrl: true
}

docs {
  No inventory row exists for this SKU.
}
