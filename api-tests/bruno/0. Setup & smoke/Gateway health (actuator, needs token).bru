meta {
  name: Gateway health (actuator, needs token)
  type: http
  seq: 2
}

get {
  url: {{gatewayUrl}}/actuator/health
  body: none
  auth: inherit
}

script:post-response {
  test('Status is 200', function () { expect(res.getStatus()).to.eql(200); });
  test('Gateway is UP', function () { expect(res.getBody().status).to.eql('UP'); });
}

settings {
  encodeUrl: true
}

docs {
  Spring Boot Actuator on the gateway. It is **not** in the gateway's public URL list, so it needs a valid token (without one you get 401). Shows the gateway's circuit breaker health indicators.
}
